<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Rules, rule lines and Excel templates belong to a company (empty: every company). A user
         of one company reads the ones of the companies they are allowed in, and the shared ones. -->
    <record id="expense_scan_policy_company_rule" model="ir.rule">
        <field name="name">Expense rules: multi-company</field>
        <field name="model_id" ref="model_expense_scan_policy"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="expense_scan_policy_rule_company_rule" model="ir.rule">
        <field name="name">Expense rule lines: multi-company</field>
        <field name="model_id" ref="model_expense_scan_policy_rule"/>
        <field name="domain_force">['|', ('policy_id.company_id', '=', False), ('policy_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="expense_scan_export_template_company_rule" model="ir.rule">
        <field name="name">Excel export templates: multi-company</field>
        <field name="model_id" ref="model_expense_scan_export_template"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="expense_scan_export_column_company_rule" model="ir.rule">
        <field name="name">Excel export columns: multi-company</field>
        <field name="model_id" ref="model_expense_scan_export_column"/>
        <field name="domain_force">['|', ('template_id.company_id', '=', False), ('template_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="expense_scan_correction_company_rule" model="ir.rule">
        <field name="name">Scan corrections: multi-company</field>
        <field name="model_id" ref="model_expense_scan_correction"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <!-- Generated sheets: one's own (generated by them or about them); every sheet for an expense
         manager. -->
    <record id="expense_scan_sheet_archive_company_rule" model="ir.rule">
        <field name="name">Generated expense sheets: multi-company</field>
        <field name="model_id" ref="model_expense_scan_sheet_archive"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="expense_scan_sheet_archive_own_rule" model="ir.rule">
        <field name="name">Generated expense sheets: one's own</field>
        <field name="model_id" ref="model_expense_scan_sheet_archive"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('employee_ids.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="expense_scan_sheet_archive_manager_rule" model="ir.rule">
        <field name="name">Generated expense sheets: all</field>
        <field name="model_id" ref="model_expense_scan_sheet_archive"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr_expense.group_hr_expense_manager'))]"/>
    </record>
    <!-- Places of the routes: an employee's home is seen by that employee and HR only, like the
         private address it comes from. Expenses show it by its name. -->
    <record id="expense_scan_place_company_rule" model="ir.rule">
        <field name="name">Places: multi-company</field>
        <field name="model_id" ref="model_expense_scan_place"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="expense_scan_place_own_rule" model="ir.rule">
        <field name="name">Places: homes are private</field>
        <field name="model_id" ref="model_expense_scan_place"/>
        <field name="domain_force">['|', ('employee_id', '=', False), ('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="expense_scan_place_approver_rule" model="ir.rule">
        <field name="name">Places: all, for HR</field>
        <field name="model_id" ref="model_expense_scan_place"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>
</odoo>
